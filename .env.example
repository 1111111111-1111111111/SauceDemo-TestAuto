# =====================================================================
# SauceDemo 自动化测试 —— 环境变量配置示例
# 用法：复制为 .env（或直接 export），config/config.py 启动时自动读取
#       cp .env.example .env
#
# 优先级：环境变量 > .env 文件 > 代码默认值
# CI 中通过 GitHub Actions workflow 的 env: 注入（见 .github/workflows/ci.yml）
# =====================================================================

# ==================== 被测站点 ====================
# BASE_URL=https://www.saucedemo.com/

# ==================== 浏览器 ====================
# BROWSER=chrome                     # chrome / firefox / edge
# HEADLESS=true                      # CI/容器必须 true

# ==================== 超时（核心治理项）====================
# CI 环境（GitHub Actions）网络延迟显著高于本地，建议按下方"参考值"配置：
# - 本地开发：EXPLICIT_WAIT=10, NAV_WAIT=20, PAGE_LOAD_TIMEOUT=30
# - GitHub Actions: EXPLICIT_WAIT=20, NAV_WAIT=30, PAGE_LOAD_TIMEOUT=60

# 元素显式等待超时（秒）—— 单个元素出现/可点击的最长等待
EXPLICIT_WAIT=20

# 页面导航/URL 变更等待（秒）—— 登录跳转、页面切换等，建议 ≥ EXPLICIT_WAIT × 1.5
NAV_WAIT=30

# 页面加载超时（秒）—— driver.get()/导航触发页面的整体加载上限
PAGE_LOAD_TIMEOUT=60

# 隐式等待（秒）—— 稳定性治理要求保持 0，全用显式等待，勿改
# IMPLICIT_WAIT=0

# CI 超时放大系数 —— CI_TIMEOUT_SCALE=2 时 EXPLICIT_WAIT=10 → 实际 20
# 显式配置 EXPLICIT_WAIT 时建议设为 1，避免双重放大
# CI_TIMEOUT_SCALE=1

# ==================== 重试策略 ====================
# 应用层（BasePage）等待失败后的重试次数与间隔（网络抖动兜底）
RETRY_TIMES=2
RETRY_INTERVAL=2

# ==================== WebDriver Manager ====================
# 驱动下载超时（秒/次）
WDM_TIMEOUT=120
# 驱动下载重试次数
WDM_RETRIES=3
# 锁定 chromedriver 版本（留空 = 自动匹配浏览器版本；CI 建议锁定避免漂移）
# 例：WDM_VERSION=122.0.6261.128
# WDM_VERSION=

# ==================== 性能监控 ====================
# 单用例耗时阈值（秒），超过记 WARNING（慢用例 ≠ 失败用例）
SLOW_TEST_THRESHOLD=60
# 单用例最长允许时间（秒），超过视为异常（预留，配合 watchdog 使用）
# MAX_TEST_DURATION=120

# ==================== 测试账号（敏感信息建议走 Secret）====================
# DEFAULT_USER=standard_user
# DEFAULT_PASSWORD=secret_sauce

# ==================== 日志 ====================
# LOG_LEVEL=INFO

# ==================== 常用命令 ====================
# 本地跑全部用例：     python -m pytest
# 本地跑登录模块：     python -m pytest testcases/test_login.py
# 冒烟用例：           python -m pytest -m smoke
# CI 参数示例：
#   CI=true HEADLESS=true EXPLICIT_WAIT=20 NAV_WAIT=30 \
#   PAGE_LOAD_TIMEOUT=60 RETRY_TIMES=2 python -m pytest
